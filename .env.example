# Otari gateway
OTARI_BASE_URL=https://api.otari.ai/api/v1
OTARI_API_KEY=

# Models. Leave the checker empty to let the app pick a different open-weight model.
READER_MODEL=mistral-small-3.2-vision
CHECKER_MODEL=

# Guardrails: profile and mode, block refuses the request before inference.
GUARDRAIL_PROFILE=prompt-injection
GUARDRAIL_MODE=block

# Per end user monthly ceiling in USD. The app stops when it is reached.
FINE_PRINT_MONTHLY_BUDGET_USD=0.25

# MCP server that answers bank IFSC lookups.
FINE_PRINT_MCP_URL=http://127.0.0.1:8099/mcp

# Local state
FINE_PRINT_DB=fine_print.sqlite3
